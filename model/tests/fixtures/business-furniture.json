  "capability": {
    "version": 1,
    "intent": {
      "en": "Offer configurable furniture with materials, custom dimensions, validated surcharges, purchasing approval and saved-order lists.",
      "de": "Konfigurierbare M\u00f6bel mit Materialien, Sonderma\u00dfen, gepr\u00fcften Zuschl\u00e4gen, Einkaufsfreigabe und gespeicherten Bestelllisten anbieten.",
      "fr": "Proposer des meubles configurables avec mat\u00e9riaux, dimensions, suppl\u00e9ments v\u00e9rifi\u00e9s, approbation et listes enregistr\u00e9es.",
      "es": "Ofrecer muebles configurables con materiales, medidas, recargos validados, aprobaci\u00f3n y listas guardadas."
    },
    "assumptions": [
      {
        "en": "Dimensions are in cm; surcharges use EUR minor units. A width greater than 240 cm adds EUR 48.",
        "de": "Ma\u00dfe in cm; Zuschl\u00e4ge in EUR-Cent. Eine Breite \u00fcber 240 cm kostet zus\u00e4tzlich 48 EUR.",
        "fr": "Dimensions en cm, suppl\u00e9ments en centimes EUR. Au-del\u00e0 de 240 cm : 48 EUR.",
        "es": "Medidas en cm, recargos en c\u00e9ntimos EUR. Un ancho superior a 240 cm a\u00f1ade 48 EUR."
      },
      {
        "en": "Native company policies determine approval. Reordering resolves current rules; completed orders retain their original configuration.",
        "de": "Die Firmenrichtlinien bestimmen die Freigabe. Nachbestellungen nutzen aktuelle Regeln; abgeschlossene Bestellungen behalten ihre urspr\u00fcngliche Konfiguration.",
        "fr": "Les r\u00e8gles entreprise d\u00e9terminent l\u2019approbation. Une nouvelle commande utilise les r\u00e8gles actuelles ; les commandes pass\u00e9es restent inchang\u00e9es.",
        "es": "Las pol\u00edticas de empresa determinan la aprobaci\u00f3n. Al repetir se usan las reglas actuales; los pedidos completados no cambian."
      }
